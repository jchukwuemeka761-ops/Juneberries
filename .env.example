# GEMINI_API_KEY: Optional for AI-assisted question formatting if enabled by admin.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Server-side HMAC signing secret for session tokens (auto-generated fallback in memory if unset).
SESSION_SECRET=""

# ADMIN_BOOTSTRAP_PASSCODE: Optional server-side passcode to gate initial Super Admin creation.
ADMIN_BOOTSTRAP_PASSCODE=""

# SUPABASE INTEGRATION (Optional — used when connecting external Supabase PostgreSQL / Auth / Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
